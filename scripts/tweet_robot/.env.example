# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is git-ignored. Never commit real secrets.

# --- OpenAI (command parsing, vision, reply text) ---
# Command parsing + reply text use a fast/cheap model; vision uses the SOTA model
# for reliable success/error detection.
OPENAI_API_KEY=
OPENAI_COMMAND_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4-mini

# --- TwitterApi.io (READ side: quote-tweets + replies) ---
TWITTERAPI_IO_API_KEY=
# WebSocket is the primary low-latency command source. Run
# setup_twitterapi_stream_rule.py once per source tweet before launching.
TWITTERAPI_STREAM_ENABLED=true
TWITTERAPI_STREAM_RECONNECT_S=90
TWITTERAPI_STREAM_RULE_INTERVAL_S=5
TWITTERAPI_STREAM_RULE_TAG_PREFIX=tweet_robot

# --- Official X API (WRITE side: replies/posts from @KuphDev) ---
# OAuth 1.0a user-context credentials for the same @KuphDev account that posts the stream tweet.
# A bearer token is NOT needed for posting.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- ElevenLabs (optional TTS narration) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Ubuntu audio playback command; the synthesized file path is appended as the
# last argument. Examples: "ffplay -nodisp -autoexit -loglevel quiet", "paplay", "aplay"
AUDIO_PLAYER_CMD=ffplay -nodisp -autoexit -loglevel quiet

# --- Accounts ---
ADMIN_HANDLE=KuphDev
# Single-account mode: the posting account and admin account are the same.
BOT_HANDLE=KuphDev

# --- Rate limits / queue / timeouts ---
MAX_REPLIES_PER_HOUR=30
ABSOLUTE_MAX_POSTS_PER_HOUR=50
MAX_QUEUE_SIZE=5
POLICY_TIMEOUT_S=30
POLICY_ERROR_RETRIES=2
# Slow REST fallback polling; WebSocket should handle most new commands.
REPLIES_V2_POLL_INTERVAL_S=300
REPLIES_V2_MAX_PAGES_PER_POLL=1
COMMAND_CONFIDENCE_THRESHOLD=0.5
VISION_CONFIDENCE_THRESHOLD=0.55
TTS_TIMEOUT_S=20

# --- Robot / camera ---
ROBOT_PORT=/dev/ttyACM0
ROBOT_ID=so101_follower
CAMERA_PATH=/dev/video0
CAMERA_WARMUP_S=0.5
POST_POLICY_WAIT_S=0.5

# Deterministic camera crop (see CAMERA_CROP.md). The OpenCV camera loads
# /home/kuphdev/lerobot/camera_crop.json automatically; this var is informational.
LEROBOT_CAMERA_CROP_CONFIG=/home/kuphdev/lerobot/camera_crop.json

# --- Policy checkpoint overrides (optional; defaults live in config.py) ---
# Paths may be absolute or relative to the repo root. Swap these to update
# policies without touching code.
# POLICY_PLACE_ORANGE=outputs/train/place_orange_duck/checkpoints/last/pretrained_model
# POLICY_REMOVE_ORANGE=outputs/train/remove_orange_duck/checkpoints/last/pretrained_model
# POLICY_PLACE_GREEN=outputs/train/place_green_duck/checkpoints/last/pretrained_model
# POLICY_REMOVE_GREEN=outputs/train/remove_green_duck/checkpoints/140000/pretrained_model
# POLICY_PLACE_YELLOW=outputs/train/place_yellow_duck_pruned_2/checkpoints/200000/pretrained_model
# POLICY_REMOVE_YELLOW=outputs/train/remove_yellow_duck_pruned/checkpoints/400000/pretrained_model
# POLICY_PLACE_PINK=outputs/train/place_pink_duck_pruned/checkpoints/last/pretrained_model
# POLICY_REMOVE_PINK=outputs/train/remove_pink_duck_pruned/checkpoints/last/pretrained_model
